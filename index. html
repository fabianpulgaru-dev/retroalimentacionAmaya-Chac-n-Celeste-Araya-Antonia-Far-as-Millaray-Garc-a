  const feedback={"h1": {"title": "Percepción personal sin respaldo", "text": "«hemos notado un gran aumento» necesita transformarse en una afirmación sostenida por evidencia. Este caso se trabaja en la ruta de Introducción y Lenguaje académico.", "lesson": 0}, "h2": {"title": "Afirmación teórica sin fuente", "text": "Aquí mencionan atención, autorregulación y lenguaje como habilidades fundamentales. La idea necesita una fuente que explique esos procesos y su relación con la primera infancia.", "lesson": 1}, "h3": {"title": "Dato informal sin función argumentativa", "text": "La búsqueda en foros puede servir para generar preguntas, pero no reemplaza evidencia académica. Además, deben explicar qué demuestra este dato.", "lesson": 2}, "h4": {"title": "Información acumulada sin función clara", "text": "La lista de caricaturas no explica qué permite comprender sobre el problema investigado. Este caso se conecta con la ruta Dato y evidencia.", "lesson": 2}, "h5": {"title": "Causalidad no demostrada", "text": "«son producidos por» afirma causalidad. Necesitan una fuente que lo demuestre o una formulación más cauta.", "lesson": 1}, "h6": {"title": "Dos afirmaciones distintas", "text": "El desplazamiento de actividades y los problemas de sueño son dos ideas distintas. Cada una necesita su propia evidencia.", "lesson": 1}, "h7": {"title": "Párrafo bien construido, pero mal ubicado", "text": "Este fragmento está bien construido porque incorpora evidencia y la interpreta. Funciona mejor si aparece antes, como parte de la contextualización del problema.", "lesson": 0}, "h8": {"title": "Lenguaje impreciso", "text": "«algo que está pasando realmente y de forma masiva» puede reemplazarse por una interpretación más precisa de los datos citados.", "lesson": 5}};
  let current=0;
  let relatedLesson=0;

  function openScreen(i){
    current=Math.max(0,Math.min(screens.length-1,i));
    document.body.classList.add('screen-open');
    app.classList.add('open');
    screens.forEach((s,idx)=>s.style.display=idx===current?'block':'none');
    chips.forEach((c,idx)=>c.classList.toggle('active',idx===current));
    mini.textContent=current===screens.length-1?'Texto comentado':('Aprendizaje '+(current+1)+' de 7');
    prev.disabled=current===0;
    next.textContent=current===screens.length-1?'Volver a la ruta':'Siguiente →';
    app.querySelector('.app-main').scrollTo({top:0,behavior:'instant'});
  }
  function closeApp(){
    app.classList.remove('open');
    document.body.classList.remove('screen-open');
    closeFeedback();
  }

  homeButtons.forEach(b=>b.addEventListener('click',()=>openScreen(parseInt(b.dataset.openLesson))));
  if(textButton) textButton.addEventListener('click',()=>openScreen(screens.length-1));
  chips.forEach(c=>c.addEventListener('click',()=>openScreen(parseInt(c.dataset.screen))));
  prev.addEventListener('click',()=>openScreen(current-1));
  next.addEventListener('click',()=> current===screens.length-1 ? closeApp() : openScreen(current+1));
  back.addEventListener('click',closeApp);

  function openFeedback(id){
    const f=feedback[id];
    if(!f)return;
    relatedLesson=f.lesson;
    sheetTitle.textContent=f.title;
    sheetText.textContent=f.text;
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden','false');
  }
  function closeFeedback(){
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden','true');
  }
  document.querySelectorAll('.hl').forEach(el=>el.addEventListener('click',()=>openFeedback(el.dataset.feedback)));
  closeSheet.addEventListener('click',closeFeedback);
  openRelated.addEventListener('click',()=>{closeFeedback();openScreen(relatedLesson);});
})();
</script>
